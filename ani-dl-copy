buscar_anime_completo() {
    local query="$1"
    local html slugs titulos tipos estados i seleccion

    html="$(curl -sL -A "Mozilla/5.0" "https://jkanime.net/buscar/${query// /%20}")"

    mapfile -t slugs < <(grep -oP '<a\s+href="https://jkanime.net/\K[^/]+(?=/")' <<< "$html" | awk '!seen[$0]++')
    mapfile -t titulos < <(grep -oP '<h5><a\s+href="[^"]+">\K[^<]+' <<< "$html")
    mapfile -t tipos < <(grep -oP '<li class="anime">\K[^<]+' <<< "$html")
    mapfile -t estados < <(grep -oP '<li>\K(Concluido|En emision)(?=</li>)' <<< "$html")

    if [[ ${#slugs[@]} -eq 0 ]]; then
        echo "Sin resultados para '$query'." >&2
        return 1
    fi

    echo "=== Resultados completos para '$query' (${#slugs[@]}) ===" >&2
    for i in "${!titulos[@]}"; do
        echo "$((i+1))) ${titulos[$i]} [${tipos[$i]:-?} - ${estados[$i]:-?}]" >&2
    done
    echo " q) Escribir nombre manualmente" >&2

    echo -n "Selecciona una opción: " >&2
    read -r seleccion

    if [[ "$seleccion" =~ ^[0-9]+$ ]] && (( seleccion >= 1 && seleccion <= ${#slugs[@]} )); then
        echo "${slugs[$((seleccion-1))]}"
        return 0
    else
        return 1
    fi
}
# Devuelve el JSON crudo de resultados de búsqueda
buscar_anime_raw() {
    local query="$1"
    local cookie_jar main_html token resultado

    cookie_jar="$(mktemp)"
    main_html="$(mktemp)"

    curl -s -c "$cookie_jar" -A "Mozilla/5.0" "https://jkanime.net/" -o "$main_html"
    token="$(grep -oP '(?<=name="csrf-token" content=")[^"]+' "$main_html")"

    if [[ -z "$token" ]]; then
        rm -f "$cookie_jar" "$main_html"
        return 1
    fi

    resultado="$(curl -s -b "$cookie_jar" -A "Mozilla/5.0" \
        -H "Accept: application/json, text/javascript, */*; q=0.01" \
        -H "Content-Type: application/x-www-form-urlencoded; charset=UTF-8" \
        -H "X-Requested-With: XMLHttpRequest" \
        -H "Origin: https://jkanime.net" \
        -H "Referer: https://jkanime.net/" \
        --data-urlencode "_token=$token" \
        --data-urlencode "q=$query" \
        "https://jkanime.net/ajax_search")"

    rm -f "$cookie_jar" "$main_html"
    printf '%s\n' "$resultado"
}


# Muestra el menú de resultados y devuelve el slug elegido por stdout
buscar_anime() {
    local query="$1"
    local json slugs titulos tipos estados seleccion

    json="$(buscar_anime_raw "$query")"

    if [[ -z "$json" || "$json" == "[]" ]]; then
        echo "Sin resultados para '$query'." >&2
        return 1
    fi

    mapfile -t slugs   < <(grep -oP '"slug":"\K[^"]+' <<< "$json")
    mapfile -t titulos < <(grep -oP '"title":"\K[^"]+' <<< "$json")
    mapfile -t tipos   < <(grep -oP '"type":"\K[^"]+' <<< "$json")
    mapfile -t estados < <(grep -oP '"status":"\K[^"]+' <<< "$json")

    echo "=== Resultados para '$query' ===" >&2
    for i in "${!titulos[@]}"; do
        echo "$((i+1))) ${titulos[$i]} [${tipos[$i]} - ${estados[$i]}]" >&2
    done
    echo " q) Escribir nombre manualmente" >&2

    echo -n "Selecciona una opción: " >&2
    read -r seleccion

    if [[ "$seleccion" =~ ^[0-9]+$ ]] && (( seleccion >= 1 && seleccion <= ${#slugs[@]} )); then
        echo "${slugs[$((seleccion-1))]}"
        return 0
    else
        return 1
    fi
}

# Ruta del archivo del historial
historial="$HOME/bash/.anime_historial"
anime=""
capitulo=""

# Cargar historial
if [[ -f "$historial" && -s "$historial" ]]; then
  echo "=== Historial ==="
  mapfile -t entradas < "$historial" # Lee lineas en arry

  for i in "${!entradas[@]}"; do
  	IFS=':' read -r nombre cap <<< "${entradas[$i]}"
	echo "$((i+1))) $nombre (cap.$cap)"
  done
  echo " $((${#entradas[@]}+1))) Ver otro anime"
  echo ""
  echo -n "Selecciona una opcion: "
  read selection

  if [[ "$selection" -ge 1 && "$selection" -le "${#entradas[@]}" ]]; then
    # Usuario eligió un anime del historial
        IFS=':' read -r anime capitulo <<< "${entradas[$((selection-1))]}"
        siguiente=$((capitulo + 1))
        echo "Último capítulo visto de '$anime': $capitulo"
        echo -n "¿Ver capítulo $siguiente? (S/N): "
        read resp
        if [[ "$resp" == "S" || "$resp" == "s" ]]; then
            capitulo=$siguiente
        else
            echo -n "Número de capítulo: "
            read capitulo
        fi
    else
      echo -n "Buscar anime (palabras clave): "
      read -r termino
      anime="$(buscar_anime "$termino")"
	  if [[ $? -ne 0 || -z "$anime" ]]; then
	    echo -n "Nombre exacto del anime (usa '-' para espacios): "
	    read -r anime
	  fi
      echo -n "Numero capitulo: "
      read -r capitulo
  fi
  fi

echo -n "¿Descargar? (S/N): "
read descarga

# ---------- Guardar/actualizar historial ----------
nueva_entrada="$anime:$capitulo"

if [[ -f "$historial" ]]; then
    # Si el anime ya existe, actualizar su línea; si no, agregar
    if grep -q "^$anime:" "$historial"; then
        sed -i "s|^$anime:.*|$nueva_entrada|" "$historial"
    else
        echo "$nueva_entrada" >> "$historial"
    fi
else
    mkdir -p "$(dirname "$historial")"
    echo "$nueva_entrada" > "$historial"
fi

# Descarga de la pagina web completa (se guarda en /tmp)
envio="https://jkanime.net/$anime/$capitulo/"
wget --user-agent="Mozilla" -p $envio -P /tmp -4

# Obtener la url del video
# ---------- Extraer URLs de todos los servidores disponibles ----------
mapfile -t um_files < <(ls /tmp/jkanime.net/jkplayer/um?e=* 2>/dev/null)

urls=()
for f in "${um_files[@]}"; do
    u="$(grep -ohP "url:\s*'\K[^']+" "$f" | head -n1)"
    if [[ -z "$u" ]]; then
        b64="$(grep -ohP "url:\s*atob\('\K[^']+" "$f" | head -n1)"
        [[ -n "$b64" ]] && u="$(echo "$b64" | base64 -d)"
    fi
    [[ -n "$u" ]] && urls+=("$u")
done

if [[ ${#urls[@]} -eq 0 ]]; then
    echo "Error: no se pudo extraer ninguna URL de video."
    rm -rf /tmp/jkanime.net
    exit 1
fi

echo "Servidores encontrados: ${#urls[@]}"

# ---------- Probar cada servidor hasta que uno funcione ----------
success=0
for i in "${!urls[@]}"; do
    u="${urls[$i]}"
    echo "--- Probando servidor $((i+1))/${#urls[@]} ---"
    echo "Url: $u"
    if [[ $descarga == "s" || $descarga == "S" ]]; then
        if yt-dlp -o "$anime-$capitulo.mp4" -N 16 --hls-prefer-native "$u" -P ~/Videos/"$anime"; then
            success=1
            break
        else
            echo "Falló el servidor $((i+1)), probando el siguiente..."
        fi
    else
        if mpv "$u"; then
            success=1
            break
        else
            echo "Falló la reproducción con el servidor $((i+1)), probando el siguiente..."
        fi
    fi
done

if [[ $success -eq 0 ]]; then
    echo "Error: ningún servidor funcionó."
fi
# Eliminar carpeta de descarga
rm -rf /tmp/jkanime.net

