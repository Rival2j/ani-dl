#!/bin/bash
cat <<"EOF"
            _            ____
 ___ ____  (_) ____  ___/ / /
/ _ `/ _ \/ / /___/ / _  / / 
\_,_/_//_/_/        \_,_/_/  
                             

EOF

# Ruta del archivo del historial
historial="$HOME/bash/.anime_historial"
anime=""
capitulo=""

# Cargar historial
if [[ -f "$historial" && -s "$historial" ]]; then
  echo "=== Historial ==="
  mapfile -t entradas < "$historial" # Lee lineas en arry

  for i in "${!entradas[@]}"; do
  	IFS=':' read -r nombre cap <<< "${entradas[$i]}"
	echo "$((i+1))) $nombre (cap.$cap)"
  done
  echo " $((${#entradas[@]}+1))) Ver otro anime"
  echo ""
  echo -n "Selecciona una opcion: "
  read selection

  if [[ "$selection" -ge 1 && "$selection" -le "${#entradas[@]}" ]]; then
    # Usuario eligió un anime del historial
        IFS=':' read -r anime capitulo <<< "${entradas[$((selection-1))]}"
        siguiente=$((capitulo + 1))
        echo "Último capítulo visto de '$anime': $capitulo"
        echo -n "¿Ver capítulo $siguiente? (S/N): "
        read resp
        if [[ "$resp" == "S" || "$resp" == "s" ]]; then
            capitulo=$siguiente
        else
            echo -n "Número de capítulo: "
            read capitulo
        fi
    else
        # Ver otro anime nuevo
        echo -n "Nombre del anime (usa '-' para espacios): "
        read anime
        echo -n "Número de capítulo: "
        read capitulo
    fi
else
    # Sin historial
    echo -n "Nombre del anime (usa '-' para espacios): "
    read anime
    echo -n "Número de capítulo: "
    read capitulo
fi

echo -n "¿Descargar? (S/N): "
read descarga

# ---------- Guardar/actualizar historial ----------
nueva_entrada="$anime:$capitulo"

if [[ -f "$historial" ]]; then
    # Si el anime ya existe, actualizar su línea; si no, agregar
    if grep -q "^$anime:" "$historial"; then
        sed -i "s|^$anime:.*|$nueva_entrada|" "$historial"
    else
        echo "$nueva_entrada" >> "$historial"
    fi
else
    mkdir -p "$(dirname "$historial")"
    echo "$nueva_entrada" > "$historial"
fi

# Descarga de la pagina web completa (se guarda en /tmp)
envio="https://jkanime.net/$anime/$capitulo/"
wget --user-agent="Mozilla" -p $envio -P /tmp -4

# Obtener la url del video
# ---------- Extraer URLs de todos los servidores disponibles ----------
mapfile -t um_files < <(ls /tmp/jkanime.net/jkplayer/um?e=* 2>/dev/null)

urls=()
for f in "${um_files[@]}"; do
    u="$(grep -ohP "url:\s*'\K[^']+" "$f" | head -n1)"
    if [[ -z "$u" ]]; then
        b64="$(grep -ohP "url:\s*atob\('\K[^']+" "$f" | head -n1)"
        [[ -n "$b64" ]] && u="$(echo "$b64" | base64 -d)"
    fi
    [[ -n "$u" ]] && urls+=("$u")
done

if [[ ${#urls[@]} -eq 0 ]]; then
    echo "Error: no se pudo extraer ninguna URL de video."
    rm -rf /tmp/jkanime.net
    exit 1
fi

echo "Servidores encontrados: ${#urls[@]}"

# ---------- Probar cada servidor hasta que uno funcione ----------
success=0
for i in "${!urls[@]}"; do
    u="${urls[$i]}"
    echo "--- Probando servidor $((i+1))/${#urls[@]} ---"
    echo "Url: $u"
    if [[ $descarga == "s" || $descarga == "S" ]]; then
        if yt-dlp -o "$anime-$capitulo.mp4" -N 16 --hls-prefer-native "$u" -P ~/Videos/"$anime"; then
            success=1
            break
        else
            echo "Falló el servidor $((i+1)), probando el siguiente..."
        fi
    else
        if mpv "$u"; then
            success=1
            break
        else
            echo "Falló la reproducción con el servidor $((i+1)), probando el siguiente..."
        fi
    fi
done

if [[ $success -eq 0 ]]; then
    echo "Error: ningún servidor funcionó."
fi
# Eliminar carpeta de descarga
rm -rf /tmp/jkanime.net
